<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs the Claude issue worker every hour while you're logged in.
  Install: see docs/CLAUDE_WORKFLOW.md. Adjust paths if your username or clone location differ.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.weinnotes.mrcc-claude-worker</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/aj/claude-worker/MRCommandCenter/scripts/claude/claude-worker.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/aj/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CLAUDE_WORKER_REPO</key>
    <string>/Users/aj/claude-worker/MRCommandCenter</string>
  </dict>

  <key>StartInterval</key>
  <integer>3600</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/aj/Library/Logs/mrcc-claude-worker/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/aj/Library/Logs/mrcc-claude-worker/launchd.err.log</string>
</dict>
</plist>
